<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DobbyShop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pure_fog</item>
        <item name="android:statusBarColor">@color/pure_white</item>
        <item name="android:navigationBarColor">@color/pure_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.DobbyShop.Splash" parent="Theme.DobbyShop">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
